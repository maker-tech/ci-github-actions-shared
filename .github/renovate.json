{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"description": "Shared Renovate preset for maker-tech repositories",
	"extends": ["config:recommended", ":ignoreUnstable"],
	"timezone": "Pacific/Auckland",
	"schedule": ["before 8am every weekday"],
	"automergeSchedule": ["before 8am every weekday"],
	"prConcurrentLimit": 5,
	"labels": ["dependencies", "automated"],
	"prCreation": "not-pending",
	"rebaseWhen": "conflicted",
	"minimumReleaseAge": "14 days",
	"gitIgnoredAuthors": ["130141323+cursor[bot]@users.noreply.github.com"],
	"vulnerabilityAlerts": {
		"enabled": true,
		"addLabels": ["security"],
		"minimumReleaseAge": null
	},
	"packageRules": [
		{
			"description": "Vulnerability alerts - highest priority",
			"matchCategories": ["security"],
			"addLabels": ["security"],
			"minimumReleaseAge": null,
			"prPriority": 100
		},
		{
			"description": "Major updates require manual review (never automerge)",
			"matchUpdateTypes": ["major"],
			"automerge": false
		},
		{
			"description": "Pin GitHub Actions digests for SHA-pinning consistency",
			"matchManagers": ["github-actions"],
			"pinDigests": true
		},
		{
			"description": "GitHub Actions - core/trusted actions (auto-merge minor/patch/digest)",
			"matchManagers": ["github-actions"],
			"matchPackageNames": [
				"actions/checkout",
				"actions/setup-node",
				"actions/cache",
				"actions/upload-artifact",
				"pnpm/action-setup"
			],
			"matchUpdateTypes": ["minor", "patch", "digest"],
			"groupName": "github-actions-core",
			"addLabels": ["github-actions"],
			"prPriority": 20,
			"automerge": true,
			"automergeType": "pr"
		},
		{
			"description": "GitHub Actions - third-party actions (longer soak, no auto-merge)",
			"matchManagers": ["github-actions"],
			"matchPackageNames": [
				"!actions/checkout",
				"!actions/setup-node",
				"!actions/cache",
				"!actions/upload-artifact",
				"!pnpm/action-setup"
			],
			"groupName": "github-actions-third-party",
			"addLabels": ["github-actions"],
			"minimumReleaseAge": "14 days",
			"prPriority": 15,
			"automerge": false
		}
	]
}
